#!/usr/bin/env -S bun --install=fallback

// vim: ft=typescript

import * as fs from "node:fs";
import { Markdown, type MarkdownTheme } from "@earendil-works/pi-tui/dist/components/markdown.js";  // 0.84.4
import { setCapabilityOverrides } from "@earendil-works/pi-tui/dist/terminal-image.js";  // 0.84.4
import hljs from "highlight.js@latest";  // 11.12.0

type Style = (text: string) => string;

const plain: Style = (text) => text;

function hex(value: string): Style {
	const r = Number.parseInt(value.slice(1, 3), 16);
	const g = Number.parseInt(value.slice(3, 5), 16);
	const b = Number.parseInt(value.slice(5, 7), 16);
	return (text) => `\x1b[38;2;${r};${g};${b}m${text}\x1b[39m`;
}

function attr(on: number, off: number): Style {
	return (text) => `\x1b[${on}m${text}\x1b[${off}m`;
}

const colored = !process.env.NO_COLOR;
const fg = colored ? hex : () => plain;
const style = colored ? attr : () => plain;

// Colors and scope assignments mirror pi's dark theme, so a fence renders the
// same here as in pi's TUI: dark.json plus buildCliHighlightTheme() in
// packages/coding-agent/src/modes/interactive/theme/theme.ts.
const comment = fg("#6A9955");
const keyword = fg("#569CD6");
const funcName = fg("#DCDCAA");
const variable = fg("#9CDCFE");
const string = fg("#CE9178");
const number = fg("#B5CEA8");
const typeName = fg("#4EC9B0");
const operator = fg("#D4D4D4");

const SCOPE_STYLES: Record<string, Style> = {
	keyword,
	built_in: typeName,
	literal: number,
	number,
	regexp: string,
	string,
	comment,
	doctag: comment,
	meta: fg("#808080"),
	function: funcName,
	title: funcName,
	class: typeName,
	type: typeName,
	tag: operator,
	name: keyword,
	attr: variable,
	variable,
	params: variable,
	operator,
	punctuation: operator,
	emphasis: style(3, 23),
	strong: style(1, 22),
	link: style(4, 24),
	addition: fg("#b5bd68"),
	deletion: fg("#cc6666"),
};

const ENTITIES: Record<string, string> = {
	"&amp;": "&",
	"&lt;": "<",
	"&gt;": ">",
	"&quot;": '"',
	"&#x27;": "'",
	"&#39;": "'",
};

// highlight.js only emits <span class="hljs-scope"> and the five escapes above,
// so scanning for those beats pulling in an HTML parser.
function htmlToAnsi(html: string): string {
	const scopes: string[] = [];
	let out = "";
	let index = 0;

	const styleFor = (): Style | undefined => {
		for (let i = scopes.length - 1; i >= 0; i--) {
			const scope = scopes[i];
			const cut = Math.min(...[scope.indexOf("."), scope.indexOf("-")].filter((at) => at !== -1), scope.length);
			const found = SCOPE_STYLES[scope] ?? SCOPE_STYLES[scope.slice(0, cut)];
			if (found) {
				return found;
			}
		}
		return undefined;
	};

	const emit = (text: string) => {
		const active = styleFor();
		// Style each line separately so splitting on newlines later cannot leave a
		// multi-line string or comment with an unterminated escape sequence.
		out += active ? text.split("\n").map(active).join("\n") : text;
	};

	while (index < html.length) {
		const next = html.indexOf("<", index);
		const entity = html.indexOf("&", index);
		const stop = Math.min(next === -1 ? html.length : next, entity === -1 ? html.length : entity);

		if (stop > index) {
			emit(html.slice(index, stop));
			index = stop;
			continue;
		}

		if (html[index] === "&") {
			const semicolon = html.indexOf(";", index);
			const decoded = semicolon === -1 ? undefined : ENTITIES[html.slice(index, semicolon + 1)];
			if (decoded) {
				emit(decoded);
				index = semicolon + 1;
				continue;
			}
			emit("&");
			index++;
			continue;
		}

		if (html.startsWith("</span>", index)) {
			scopes.pop();
			index += 7;
			continue;
		}

		const tagEnd = html.indexOf(">", index);
		if (tagEnd === -1) {
			emit(html.slice(index));
			break;
		}
		scopes.push(/class="hljs-([^"]*)"/.exec(html.slice(index, tagEnd))?.[1] ?? "");
		index = tagEnd + 1;
	}

	return out;
}

const codeBlock = fg("#b5bd68");

function highlightCode(code: string, lang?: string): string[] {
	// Never auto-detect: highlight.js guesses badly on short or prose-like
	// snippets, coloring random English words as keywords.
	const language = lang?.trim().split(/\s+/, 1)[0];
	if (!language || !hljs.getLanguage(language)) {
		return code.split("\n").map((line) => codeBlock(line));
	}
	try {
		return htmlToAnsi(hljs.highlight(code, { language, ignoreIllegals: true }).value).split("\n");
	} catch {
		return code.split("\n").map((line) => codeBlock(line));
	}
}

const theme: MarkdownTheme = {
	heading: fg("#f0c674"),
	link: fg("#81a2be"),
	linkUrl: fg("#666666"),
	code: fg("#8abeb7"),
	codeBlock,
	codeBlockBorder: fg("#808080"),
	quote: fg("#808080"),
	quoteBorder: fg("#808080"),
	hr: fg("#808080"),
	listBullet: fg("#8abeb7"),
	bold: style(1, 22),
	italic: style(3, 23),
	underline: style(4, 24),
	strikethrough: style(9, 29),
	...(colored ? { highlightCode } : {}),
};

// OSC 8 detection reads TERM, not whether stdout is a terminal, so plain-text
// output would still carry hyperlink escapes. Fall back to "text (url)" instead.
if (!colored) {
	setCapabilityOverrides({ hyperlinks: false });
}

const envColumns = Number.parseInt(process.env.COLUMNS ?? "", 10);
const width = process.stdout.columns ?? (envColumns > 0 ? envColumns : 100);

const file = process.argv[2];
let source: string;
try {
	source = file && file !== "-" ? fs.readFileSync(file, "utf8") : fs.readFileSync(0, "utf8");
} catch (error) {
	process.stderr.write(`pi-md: ${error instanceof Error ? error.message : String(error)}\n`);
	process.exit(1);
}

const lines = new Markdown(source, 0, 0, theme).render(width);

if (lines.length > 0) {
	process.stdout.write(`${lines.map((line) => line.replace(/ +$/, "")).join("\n")}\n`);
}

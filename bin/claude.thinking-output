#!/usr/bin/env bash

set -e

# Colors, the one-column pad and the 5-line output preview mirror pi's TUI:
# dark.json (text, thinkingText, toolTitle, toolOutput) and BASH_PREVIEW_LINES
# in packages/coding-agent/src/core/tools/bash.ts.
gray=$'\033[38;2;128;128;128m'
text=$'\033[38;2;212;212;212m'
bright=$'\033[1m'$text
italic=$'\033[3m'
reset=$'\033[0m'
preview_lines=5

# Inside $() stdout is a pipe, so tput measures the window through stderr;
# closing stderr makes it fall back to terminfo's static 80 and still exit 0.
width=$(tput cols || echo 100)
width=100
body=$((width - 1))

jq_stream='
if .type == "assistant" then
  (.message.content[]?
   | if .type == "thinking" then
       # "-" keeps the id field non-empty: read collapses consecutive tabs.
       ["thinking", "-", .thinking]
     elif .type == "text" then
       ["text", "-", .text]
     elif .type == "tool_use" and .name == "Bash" then
       ["bash", .id, (.input.command // "")]
     else empty end),
  # One message spans several lines, each repeating stop_reason; the closing
  # text block is always the last of them.
  (select(.message.stop_reason == "end_turn"
          and (.message.content | last | .type) == "text")
   | ["end", "-", "-"])
elif .type == "user" then
  .message.content[]?
  | select(.type == "tool_result")
  | ["output", .tool_use_id,
     (if (.content | type) == "string" then .content
      else [.content[]? | select(.type == "text") | .text] | join("\n") end)]
else empty end
| select(.[2] | test("\\S"))
| .[0] + "\t" + .[1] + "\t" + (.[2] | @json)
'

main() {
  local session_id show_text arg f kind id json last
  local -A pending

  for arg; do
    case $arg in
      -t|--text) show_text=true ;;
      *) session_id=$arg ;;
    esac
  done

  f=$(find "$HOME/.claude/projects" -type f -name "$session_id*.jsonl" | head -1)

  if [[ ! -f $f ]]; then
    echo "Could not find matching session" >&2
    exit 1
  fi

  echo "Following session: $f"

  tail -f "$f" |
    jq -r --unbuffered "$jq_stream" |
    while IFS=$'\t' read -r kind id json; do
      # Anything not rendered leaves $last alone, so two thoughts with only a
      # silent event between them still read as two thoughts.
      case $kind in
        thinking)
          if [[ $last == thinking ]]; then
            render_thought_break
          fi
          render_thinking "$(jq -r . <<< "$json")"
          ;;
        text)
          if [[ -z $show_text ]]; then
            continue
          fi
          render_text "$(jq -r . <<< "$json")"
          ;;
        end)
          render_separator
          ;;
        bash)
          pending[$id]=1
          render_command "$(jq -r . <<< "$json")"
          ;;
        output)
          if [[ -z ${pending[$id]} ]]; then
            continue
          fi
          unset "pending[$id]"
          render_output "$(jq -r . <<< "$json")"
          ;;
      esac
      last=$kind
    done
}

render_thinking() {
  echo
  printf '%s\n' "$1" | NO_COLOR=1 COLUMNS=$body pi.tui-md | pad "$italic$gray"
}

render_text() {
  echo
  printf '%s\n' "$1" | COLUMNS=$body pi.tui-md | pad "$text"
}

render_separator() {
  echo
  printf '%s%s%s\n' "$gray" "$(rule $width)" "$reset"
}

render_thought_break() {
  echo
  printf '%s %s%s\n' "$gray" "$(rule 20)" "$reset"
}

rule() {
  printf "%${1}s" | tr ' ' -
}

render_command() {
  echo
  printf '%s\n' "$bright \$ $1$reset"
}

render_output() {
  local wrapped skipped
  wrapped=$(printf '%s\n' "$1" | strip_ansi | fold -s -w $body)
  skipped=$(printf '%s\n' "$wrapped" | awk -v keep=$preview_lines 'END {print NR - keep}')

  echo
  if [[ $skipped -gt 0 ]]; then
    printf '%s\n' "$gray ... ($skipped earlier lines)$reset"
  fi
  printf '%s\n' "$wrapped" | tail -n $preview_lines | pad "$gray"
}

pad() {
  local prefix=$1 line
  while IFS= read -r line; do
    printf '%s\n' "${line:+$prefix $line$reset}"
  done
}

strip_ansi() {
  awk -v esc=$'\033' '{gsub(esc "\\[[0-9;]*[a-zA-Z]", ""); print}'
}

main "$@"

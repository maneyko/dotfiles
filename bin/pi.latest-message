#!/bin/bash

set -e

if [[ $1 =~ ^(-f|--file)$ ]]; then
  FILE_ONLY=true
fi

find "$HOME/.pi/agent/sessions/" -type f \
  -exec stat -f "%m %N" {} + |
  sort -nk1 | tail -1 | awk '{$1=""; $0=substr($0,2)}1' |
  while read -r line; do
    if [[ -n $FILE_ONLY ]]; then
      echo "$line"
    else
      tail -1 "$line" | jq -r '.message.content[-1] | .text'
    fi
  done
